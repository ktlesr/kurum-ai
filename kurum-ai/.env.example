# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env git'e girmez.
# Gizli değer üretmek için:  openssl rand -hex 32
#   (Windows PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))

# ============ Ortak ============

# Oturum imzalama anahtarı. Değiştirirseniz tüm kullanıcıların oturumu kapanır.
WEBUI_SECRET_KEY=

# Arayüzde görünen ad
WEBUI_NAME=Kurum AI

# Open WebUI sürümü. Güncelleme yalnızca README'deki kontrollü güncelleme prosedürüyle yapılır.
WEBUI_VERSION=v0.11.4

# ============ Aşama 1 (pilot, Windows) ============

# Tarayıcıdan erişilecek port: http://<bilgisayar>:3000
WEBUI_PORT=3000
# Ollama'da yüklü olması gereken embedding modeli (ollama pull embeddinggemma)
EMBEDDING_MODEL=embeddinggemma:latest

# ============ Aşama 2 (üretim, AI cihazı) ============

# Kullanıcıların tarayıcıda açacağı kurum içi adres. DNS'te cihazın IP'sine yönlenmeli.
DOMAIN=ai.kurum.local

# HTTPS sertifikası:
#   internal → Caddy'nin kendi iç CA'sı (kök sertifikayı istemcilere dağıtın, README)
#   kurum    → kurum CA'sından alınan sertifika: certs/cert.pem (zincir dahil) ve certs/key.pem
CADDY_TLS=internal

# Open WebUI → vLLM erişim anahtarı (yalnızca iç ağda kullanılır)
VLLM_API_KEY=

# Sunulacak model (Hugging Face adı). Değiştirirseniz önce scripts/download-models.sh ile indirin.
LLM_MODEL=openai/gpt-oss-20b
# LLM_MODEL değişirse araç çağırma ayrıştırıcısı da değişmeli: gpt-oss → openai, gemma4 → gemma4, qwen3 → hermes
VLLM_TOOL_PARSER=openai
# GPU/birleşik belleğin vLLM'e ayrılan oranı (model + KV cache). Open WebUI ve sistem için pay bırakın.
VLLM_GPU_MEMORY_UTILIZATION=0.6
# NVIDIA NGC vLLM imaj sürümü (nvcr.io/nvidia/vllm)
VLLM_VERSION=26.09-py3

# Doküman araması için embedding modeli (Hugging Face adı, Türkçe destekli çok dilli)
HF_EMBEDDING_MODEL=BAAI/bge-m3

CADDY_VERSION=2.10.2-alpine

# --- LDAP / Active Directory (opsiyonel, varsayılan kapalı) ---
# Not: Open WebUI bu ayarları yalnızca İLK açılışta okur; sonradan Yönetici Paneli → Ayarlar → Genel → LDAP.
ENABLE_LDAP=false
LDAP_SERVER_LABEL=Kurum Hesabı
LDAP_SERVER_HOST=dc01.kurum.local
LDAP_SERVER_PORT=636
LDAP_USE_TLS=true
LDAP_VALIDATE_CERT=true
# Kurum CA sertifikası (certs/ klasörüne koyun): /certs/kurum-ca.pem
LDAP_CA_CERT_FILE=
# Arama için salt-okunur servis hesabı
LDAP_APP_DN=CN=svc-ai,OU=Servis Hesaplari,DC=kurum,DC=local
LDAP_APP_PASSWORD=
LDAP_SEARCH_BASE=OU=Kullanicilar,DC=kurum,DC=local
# Yalnızca belirli bir AD grubu girebilsin (opsiyonel):
#   (memberOf=CN=AI-Kullanicilari,OU=Gruplar,DC=kurum,DC=local)
LDAP_SEARCH_FILTERS=
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail
